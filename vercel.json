{
  "version": 2,
  "builds": [
    {
      "src": "src/demo-app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/docs/(.*)",
      "dest": "/docs/$1"
    },
    {
      "src": "/(.*)",
      "dest": "src/demo-app.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
