{
  "version": 2,
  "builds": [
    {
      "src": "src/simple-app.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/src/simple-app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/src/simple-app.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
