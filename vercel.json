{
  "version": 2,
  "builds": [
    {
      "src": "src/docs-app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/docs/swagger-ui.css",
      "dest": "/node_modules/swagger-ui-dist/swagger-ui.css"
    },
    {
      "src": "/docs/swagger-ui-bundle.js",
      "dest": "/node_modules/swagger-ui-dist/swagger-ui-bundle.js"
    },
    {
      "src": "/docs/swagger-ui-standalone-preset.js",
      "dest": "/node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/docs-app.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
