{
  "version": 2,
  "builds": [
    {
      "src": "src/demo-app.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/docs/(.*)",
      "destination": "/docs/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/src/demo-app.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
